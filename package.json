{
  "name": "learncache",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paolodit/learncache.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "node --no-warnings node_modules/tsx/dist/cli.mjs watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 3000",
    "start": "node dist-server/server/index.js",
    "tools:install-ytdlp": "powershell -ExecutionPolicy Bypass -File scripts/install-ytdlp.ps1",
    "setup:extension": "node extension/scripts/setup.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/fastify": "^3.1.40",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "openai": "^7.45.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.12"
  }
}
