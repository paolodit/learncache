{
  "name": "learncache-extension",
  "displayName": "LearnCache",
  "description": "Capture YouTube and podcast links into LearnCache.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paolodit/learncache.git",
    "directory": "extension"
  },
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:local": "node scripts/build-local.mjs",
    "package": "plasmo package"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^2.6.4",
    "plasmo": "^0.90.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "manifest": {
    "permissions": ["activeTab", "contextMenus", "cookies", "scripting", "storage"],
    "host_permissions": ["http://127.0.0.1:3000/*", "http://localhost:3000/*", "https://www.youtube.com/*"]
  }
}
